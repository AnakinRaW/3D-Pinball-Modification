# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Editors / IDEs
.vscode/
.idea/

# FreeCAD backups
*.FCStd1
*.FCBak

# Firmware build output
build/
.pio/
.pioenvs/
*.hex
*.elf
# the release build's compile commands, which firmware/tools/tidy.py and an editor's clangd read
compile_commands.json
# the host screens' fonts, which tools/fonts.py converts from firmware/fonts/ before every build
firmware/src/host/views/fonts/
# the .gitignore PlatformIO's VS Code setup writes into every project folder
firmware/**/.gitignore

# Python helper scripts
__pycache__/
*.pyc
.venv/

*.bak
*.3mf
assets/ROKR-3D-Pinball-EG01.pdf
