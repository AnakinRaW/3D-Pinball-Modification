# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

# Text
*.md      text
*.txt     text
*.json    text
*.csv     text
*.c       text
*.h       text
*.cpp     text
*.hpp     text
*.ino     text
*.py      text
*.yml     text
*.yaml    text
*.sh      text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Fabrication outputs are sent to a manufacturer and must reach them byte-for-byte
# as the EDA tool wrote them. Never rewrite their line endings.
*.gbr     -text
*.gbl     -text
*.gtl     -text
*.gbs     -text
*.gts     -text
*.gbo     -text
*.gto     -text
*.gbp     -text
*.gtp     -text
*.gm1     -text
*.gko     -text
*.drl     -text
*.xln     -text

# CAD. STEP is ASCII but far too large to diff usefully; the rest are binary
# containers (FCStd and 3MF are ZIP archives).
*.step    -text -diff
*.stp     -text -diff
*.stl     binary
*.3mf     binary
*.FCStd   binary
*.FCStd1  binary
*.f3d     binary
*.f3z     binary
*.sldprt  binary
*.sldasm  binary
*.ipt     binary
*.iam     binary

# Media and documents
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.mp4     binary
*.pdf     binary
*.zip     binary

# Keep generated fabrication output out of diffs and language statistics.
hardware/pcb/**/fab/** linguist-generated=true
